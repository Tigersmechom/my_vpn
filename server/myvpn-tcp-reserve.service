[Unit]
Description=My VPN TCP reserve with remote exit
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LoadCredential=config.json:/etc/myvpn-tcp/config.json
ExecStart=/usr/local/lib/myvpn-tcp/xray run -c %d/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
