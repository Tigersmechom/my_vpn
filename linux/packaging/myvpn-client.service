[Unit]
Description=My VPN client tunnel
After=network.target systemd-resolved.service
Requires=systemd-resolved.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/myvpn/myvpn-helper engine
ExecStopPost=/usr/lib/myvpn/myvpn-helper cleanup
TimeoutStartSec=40
TimeoutStopSec=15
KillMode=control-group
Restart=no
RuntimeDirectory=myvpn-client
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ReadWritePaths=/run/myvpn-client /run/myvpn-client-status /run/amneziawg

# Started explicitly by the GUI after polkit authorization; never enable at boot.
